#!/usr/bin/env bash
# Connect to the stelab box.
#
#   box                 attach tmux session "main"
#   box <name>          attach/create tmux session <name>
#   box stop            stop the machine (saves CPU/RAM, volume persists)
#   box status          show machine and proxy state
#   box ls              list tmux sessions
#   box kill            kill all tmux sessions except current
#   box kill -s <name>  kill a specific tmux session
#   box -- <command>    run a command non-interactively
#
set -euo pipefail

APP=stelab
MACHINE_PORT=2222
LOCAL_PORT=2222
PROXY_LOG="${TMPDIR:-/tmp}/stelab-proxy.log"

die() { echo "box: $*" >&2; exit 1; }

command -v fly >/dev/null || die "fly CLI not on PATH"

listening() { nc -z 127.0.0.1 "$LOCAL_PORT" >/dev/null 2>&1; }

machine_field() {
  fly machines list -a "$APP" --json 2>/dev/null \
    | python3 -c "import json,sys
d=json.load(sys.stdin)
print(d[0]['$1'] if d else '')" 2>/dev/null || echo ''
}

# --- helpers: ensure machine + proxy are up ---------------------------------
ensure_machine() {
  local state
  state="$(machine_field state)"
  if [ "$state" != "started" ]; then
    mid="$(machine_field id)"
    [ -n "$mid" ] || die "no machine found for app '$APP'"
    echo "box: machine is '${state:-unknown}', starting $mid"
    fly machine start "$mid" -a "$APP" || die "could not start $mid"
    for _ in $(seq 1 30); do sleep 1; [ "$(machine_field state)" = "started" ] && break; done
    [ "$(machine_field state)" = "started" ] || die "machine did not reach started"
  fi
}

ensure_proxy() {
  if ! listening; then
    echo "box: starting proxy :$LOCAL_PORT -> $APP:$MACHINE_PORT"
    fly proxy "$LOCAL_PORT:$MACHINE_PORT" -a "$APP" >"$PROXY_LOG" 2>&1 &
    for _ in $(seq 1 40); do
      listening && break
      sleep 0.5
    done
    listening || die "proxy did not come up; see $PROXY_LOG"
  fi
}

KNOWN_HOSTS="$HOME/.ssh/known_hosts_stelab"

SSH_OPTS=(
  -p "$LOCAL_PORT"
  -o UserKnownHostsFile="$KNOWN_HOSTS"
  -o StrictHostKeyChecking=accept-new
  -o ServerAliveInterval=30
  -A
)

# --- subcommands that DON'T need a running machine -------------------------
case "${1:-}" in
  stop)
    mid="$(machine_field id)"
    [ -n "$mid" ] || die "no machine found for app '$APP'"
    pkill -f "fly proxy $LOCAL_PORT" 2>/dev/null || true
    exec fly machine stop "$mid" -a "$APP"
    ;;
  status)
    echo "machine: $(machine_field id)  state: $(machine_field state)"
    listening && echo "proxy:   up on :$LOCAL_PORT" || echo "proxy:   down"
    exit 0
    ;;
esac

# --- subcommands that need machine + proxy up ------------------------------
ensure_machine
ensure_proxy

case "${1:-}" in
  ls)
    exec ssh "${SSH_OPTS[@]}" root@127.0.0.1 tmux list-sessions
    ;;
  kill)
    if [ "${2:-}" = "-s" ]; then
      [ -n "${3:-}" ] || die "usage: box kill -s <session-name>"
      exec ssh "${SSH_OPTS[@]}" root@127.0.0.1 tmux kill-session -t "$3"
    else
      exec ssh "${SSH_OPTS[@]}" root@127.0.0.1 tmux kill-session -a
    fi
    ;;
esac

# --- non-interactive command ------------------------------------------------
if [ "${1:-}" = "--" ]; then
  shift
  [ $# -gt 0 ] || die "nothing to run after --"
  exec ssh "${SSH_OPTS[@]}" root@127.0.0.1 "$@"
fi

# --- attach to session ------------------------------------------------------
SESSION="${1:-main}"
exec ssh "${SSH_OPTS[@]}" -t root@127.0.0.1 \
  "COLORTERM=truecolor tmux new-session -A -s '$SESSION'"
